# 로컬 개발용 예시. 복사해서 .env로 쓰고, .env는 커밋하지 않습니다.
APP_ENV=development

# 학교 LLM (OpenAI 호환). 키는 각자 받은 값을 .env에만 넣습니다.
SCHOOL_LLM_BASE_URL=
SCHOOL_LLM_API_KEY=

# ai_jobs 작업 처리기(python -m app.worker). 접속 문자열은 .env에만 넣습니다.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=notelink

# 노트 OCR(Azure Document Intelligence) · 파일(Blob). 값은 각자 .env에만 넣습니다.
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# 노트 조각 임베딩(Voyage). Atlas에서 받은 키는 주소가 다를 수 있습니다.
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_API_KEY=

# 노트 후처리(오타 고치기 · 개념 태그). 과목 용어 사전이 준비되면 켬
NOTE_REFINE_ENABLED=false
# 시드 용어 찾기(Claude 웹 검색). 키가 없으면 작업 input의 시드로만 처리
ANTHROPIC_API_KEY=
# 검색할 사이트(JSON 목록). 비면 제한 없음
SEED_SEARCH_DOMAINS=[]
